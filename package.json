{
  "name": "mikrotik-skill",
  "version": "1.1.2",
  "description": "Production-grade MikroTik RouterOS v7 automation skill, CLI toolkit, and MCP server for network engineers and AI agents.",
  "author": "Ardian Ryan <me@ardianryan.com>",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mikrotik-skill": "dist/cli/index.js",
    "mtik": "dist/cli/index.js",
    "mtik-mcp": "dist/mcp/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardianryan/MikroTik-Skill.git"
  },
  "homepage": "https://github.com/ardianryan/MikroTik-Skill#readme",
  "bugs": {
    "url": "https://github.com/ardianryan/MikroTik-Skill/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    ".agents/skills/mikrotik"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "mtik": "tsx src/cli/index.ts",
    "mcp": "tsx src/mcp/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mikrotik",
    "routeros",
    "routeros-v7",
    "networking",
    "cli",
    "mcp",
    "mcp-server",
    "antigravity",
    "wireguard",
    "radius",
    "cake-qos"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "node-routeros": "^1.6.9",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
